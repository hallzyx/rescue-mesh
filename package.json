{
  "name": "rescuemesh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 43147",
    "dev:peer-a": "RESCUEMESH_NEXT_DIST=.next-a RESCUEMESH_P2P_STORAGE=.p2p-data-a RESCUEMESH_INSTANCE_LABEL=Citizen next dev --port 43147",
    "dev:peer-b": "RESCUEMESH_NEXT_DIST=.next-b RESCUEMESH_P2P_STORAGE=.p2p-data-b RESCUEMESH_INSTANCE_LABEL=Brigade next dev --port 43148",
    "dev:peer-c": "RESCUEMESH_NEXT_DIST=.next-c RESCUEMESH_P2P_STORAGE=.p2p-data-c RESCUEMESH_INSTANCE_LABEL=Command Center next dev --port 43149",
    "build": "next build",
    "start": "next start --port 43147",
    "lint": "eslint",
    "test": "playwright test && playwright test --config=playwright.demo.config.ts",
    "test:smoke": "playwright test --project=smoke",
    "test:e2e": "playwright test --project=e2e",
    "test:demo": "playwright test --config=playwright.demo.config.ts",
    "verify": "npm run build && npm run lint && npm run test",
    "verify:demo": "node scripts/verify-demo.mjs",
    "compose": "docker compose up --build",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "corestore": "^7.12.0",
    "hyperbee": "^2.27.3",
    "hyperswarm": "^4.17.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
